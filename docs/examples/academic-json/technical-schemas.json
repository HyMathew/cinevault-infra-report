{
  "$defs": {
    "ClientContext": {
      "additionalProperties": false,
      "description": "Serialized synthetic context carrier generated by this tool, with native header constraints from client_context.client_address. HMAC, canonical IP, exact body binding and freshness require executable checks.",
      "properties": {
        "accepted_only_at_fictional_clock": {
          "minimum": 0,
          "type": "integer"
        },
        "body_utf8": {
          "pattern": "^[^\\ud800-\\udfff]*$",
          "type": "string"
        },
        "fictional_key_hex": {
          "pattern": "^(?:[0-9a-f]{2}){32,}$",
          "type": "string"
        },
        "headers": {
          "$comment": "The native HTTP boundary permits other headers; only the selected JSON carrier fields are described here.",
          "additionalProperties": {
            "pattern": "^[^\\ud800-\\udfff]*$",
            "type": "string"
          },
          "properties": {
            "Content-Type": {
              "const": "application/json"
            },
            "X-CineVault-Client-IP": {
              "anyOf": [
                {
                  "format": "ipv4"
                },
                {
                  "format": "ipv6"
                }
              ],
              "maxLength": 45,
              "not": {
                "pattern": "%"
              },
              "type": "string"
            },
            "X-CineVault-Client-Signature": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "X-CineVault-Client-Time": {
              "pattern": "^(?:0|[1-9][0-9]{0,9})$",
              "type": "string"
            }
          },
          "required": [
            "Content-Type",
            "X-CineVault-Client-IP",
            "X-CineVault-Client-Time",
            "X-CineVault-Client-Signature"
          ],
          "type": "object"
        },
        "rejected_at": {
          "minimum": 0,
          "type": "integer"
        },
        "signed_message": {
          "pattern": "^cinevault-client-v1\\n(?:0|[1-9][0-9]{0,9})\\n[^\\n]+\\nPOST\\n/api/v1/auth/(?:login|register)\\n[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "fictional_key_hex",
        "body_utf8",
        "headers",
        "signed_message",
        "accepted_only_at_fictional_clock",
        "rejected_at"
      ],
      "type": "object"
    },
    "Health": {
      "additionalProperties": false,
      "description": "Successful /health carrier emitted by create_app; actual storage availability is checked by the handler.",
      "properties": {
        "status": {
          "const": "ok",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    },
    "LegacyCatalogue": {
      "additionalProperties": false,
      "description": "Persistent legacy catalogue; Repository._read and validation.validate. Distinct film IDs remain checked by Repository.",
      "properties": {
        "films": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "acteurs": {
                "items": {
                  "allOf": [
                    {
                      "pattern": "^[^\\ud800-\\udfff]*$",
                      "type": "string"
                    },
                    {
                      "not": {
                        "pattern": "^\\s|\\s$"
                      }
                    }
                  ],
                  "maxLength": 120,
                  "minLength": 1,
                  "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
                  "type": "string"
                },
                "maxItems": 30,
                "type": "array"
              },
              "annee": {
                "maximum": 2100,
                "minimum": 1888,
                "type": "integer"
              },
              "id": {
                "format": "uuid",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                "type": "string"
              },
              "realisateur": {
                "allOf": [
                  {
                    "pattern": "^[^\\ud800-\\udfff]*$",
                    "type": "string"
                  },
                  {
                    "not": {
                      "pattern": "^\\s|\\s$"
                    }
                  }
                ],
                "maxLength": 120,
                "minLength": 1,
                "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
                "type": "string"
              },
              "support": {
                "enum": [
                  "numerique",
                  "dvd",
                  "blu-ray",
                  "vhs",
                  "autre"
                ]
              },
              "synopsis": {
                "maxLength": 4000,
                "pattern": "^[^\\ud800-\\udfff]*$",
                "type": "string"
              },
              "titre": {
                "allOf": [
                  {
                    "pattern": "^[^\\ud800-\\udfff]*$",
                    "type": "string"
                  },
                  {
                    "not": {
                      "pattern": "^\\s|\\s$"
                    }
                  }
                ],
                "maxLength": 200,
                "minLength": 1,
                "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
                "type": "string"
              }
            },
            "required": [
              "id",
              "titre",
              "annee",
              "realisateur",
              "acteurs",
              "support",
              "synopsis"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "films"
      ],
      "type": "object"
    },
    "MetadataCache": {
      "additionalProperties": false,
      "description": "MetadataCache.read/check_value. TTL=86400, grace=604800, relative clocks and byte limits are checked by code.",
      "properties": {
        "blocked_until": {
          "minimum": 0,
          "type": "integer"
        },
        "count": {
          "maximum": 20,
          "minimum": 0,
          "type": "integer"
        },
        "entries": {
          "additionalProperties": {
            "additionalProperties": false,
            "properties": {
              "expires_at": {
                "minimum": 0,
                "type": "integer"
              },
              "stale_until": {
                "minimum": 0,
                "type": "integer"
              },
              "stored_at": {
                "minimum": 0,
                "type": "integer"
              },
              "value": {
                "$comment": "MetadataCache.check_value permits arbitrary JSON object values except cache; UTF-8 size <=32768 bytes is checked by code.",
                "additionalProperties": true,
                "not": {
                  "required": [
                    "cache"
                  ]
                },
                "type": "object"
              }
            },
            "required": [
              "stored_at",
              "expires_at",
              "stale_until",
              "value"
            ],
            "type": "object"
          },
          "maxProperties": 100,
          "propertyNames": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "type": "object"
        },
        "version": {
          "const": 1,
          "type": "integer"
        },
        "window_start": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "version",
        "window_start",
        "count",
        "blocked_until",
        "entries"
      ],
      "type": "object"
    },
    "RecoveryReport": {
      "additionalProperties": false,
      "description": "Report emitted by recovery.recover. File digests, source counts and quarantine effects require executable checks.",
      "properties": {
        "closed_reservations": {
          "minimum": 0,
          "type": "integer"
        },
        "disabled_users": {
          "minimum": 0,
          "type": "integer"
        },
        "operation_id": {
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        },
        "revoked_sessions": {
          "minimum": 0,
          "type": "integer"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "target_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "operation_id",
        "source_sha256",
        "target_sha256",
        "disabled_users",
        "revoked_sessions",
        "closed_reservations"
      ],
      "type": "object"
    }
  },
  "$id": "urn:cinevault:academic:technical:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CineVault technical academic contracts"
}
